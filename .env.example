# Copy to .dev.vars for Pages local development. No VITE_ secrets.
API_TOKEN=replace-with-at-least-32-random-characters
DASHBOARD_ORIGIN=http://localhost:8788
ALLOWED_HOSTS=your-authorized-domain.example
RUNNER_URL=http://127.0.0.1:8790
RUNNER_TOKEN=replace-with-a-different-32-character-secret
# Runner uses environment variables, not .dev.vars automatically.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8790
# Explicitly permitted input endpoint paths; no query strings. Empty disables input probes.
INPUT_PATHS=/security-test
# Optional port checks; disabled unless set. Max 4, allowed subset: 80,443,8080,8443.
ALLOWED_PORTS=
